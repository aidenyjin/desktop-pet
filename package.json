{
  "name": "sonatina",
  "productName": "Sonatina",
  "version": "0.1.0",
  "private": true,
  "description": "A little composer who lives in your menu bar and writes music while you work.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "shots": "node scripts/shot-app.mjs && node scripts/shot-scene.mjs",
    "simulate": "node --import tsx scripts/simulate.ts",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "app:build:universal": "tauri build --target universal-apple-darwin",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@fontsource/libre-baskerville": "^5.3.0",
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tauri-apps/cli": "^2.11.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "license": "MIT"
}
